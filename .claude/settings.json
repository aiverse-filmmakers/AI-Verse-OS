{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Bash(cat *.env)",
      "Bash(* .env)",
      "Bash(* ./.env)",
      "Bash(source *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Edit(./scripts/secrets.mjs)",
      "Write(./scripts/secrets.mjs)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.env.allow)",
      "Write(./.env.allow)",
      "Edit(**/.env.local)",
      "Write(**/.env.local)",
      "Edit(**/.env.production)",
      "Write(**/.env.production)",
      "Edit(**/.env.development)",
      "Write(**/.env.development)"
    ],
    "ask": [
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.aiverse/extensions/**)",
      "Edit(./.codex/**)",
      "Bash(node scripts/secrets.mjs run *)",
      "Bash(node scripts/secrets.mjs set *)",
      "Bash(node scripts/secrets.mjs status)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "disableSkillShellExecution": true,
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.local",
        "~/.config/gh",
        "~/.codex/auth.json",
        "~/.ssh",
        "~/.aws/credentials",
        "~/.npmrc",
        "~/.netrc"
      ],
      "denyWrite": [
        "scripts/secrets.mjs",
        ".env",
        ".env.allow",
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".claude/hooks"
      ]
    }
  }
}
