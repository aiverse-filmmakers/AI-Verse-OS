{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Verse external capability index v1",
  "$comment": "Shape validation only. Consumers must also enforce the semantic checks in README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "provider_id",
    "generation_id",
    "manifest_sha256",
    "capabilities"
  ],
  "properties": {
    "contract": {
      "const": "aiverse-capability-provider-v1"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^(os|aiverse-skills|local|workspace:[a-z0-9][a-z0-9-]*)$"
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "visibility",
          "version",
          "path",
          "package_state",
          "digest",
          "operators",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(os|aiverse-skills|local):[a-z0-9][a-z0-9-]*$|^workspace:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "string",
            "pattern": "^(system|shared|workspace:[a-z0-9][a-z0-9-]*)$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000]).*[^/]$"
          },
          "package_state": {
            "enum": [
              "valid",
              "broken"
            ]
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "const": "aiverse-package-sha256-v1"
              },
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "operators": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
