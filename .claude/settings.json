{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ],
    "ask": [
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.aiverse/extensions/**)",
      "Edit(./.codex/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "disableSkillShellExecution": true,
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [".env", ".env.local", "~/.config/gh", "~/.codex/auth.json", "~/.ssh", "~/.aws/credentials", "~/.npmrc", "~/.netrc"]
    }
  }
}
