# Force LF so Windows CRLF checkouts cannot change pinned file hashes.
* text=auto eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Windows batch files need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.mp4 binary
*.sqlite binary
*.db binary
